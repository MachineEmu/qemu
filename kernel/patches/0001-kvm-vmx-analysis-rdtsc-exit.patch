+/*
+ * Lab-only analysis controls.  Disabled by default so ordinary KVM behavior is
+ * unchanged.  When enabled, VMX exits on guest RDTSC and emulates the read in
+ * KVM, optionally subtracting a fixed cycle budget and enforcing monotonicity
+ * for the selected qemu-system TGID.
+ */
+static bool __read_mostly analysis_rdtsc_exit;
+module_param_named(analysis_rdtsc_exit, analysis_rdtsc_exit, bool, 0644);
+
+static int __read_mostly analysis_target_tgid = -1;
+module_param_named(analysis_target_tgid, analysis_target_tgid, int, 0644);
+
+static ulong __read_mostly analysis_rdtsc_subtract_cycles;
+module_param_named(analysis_rdtsc_subtract_cycles, analysis_rdtsc_subtract_cycles, ulong, 0644);
+
+static ulong analysis_rdtsc_observed;
+module_param_named(analysis_rdtsc_observed, analysis_rdtsc_observed, ulong, 0444);
+
+static ulong analysis_rdtsc_adjusted;
+module_param_named(analysis_rdtsc_adjusted, analysis_rdtsc_adjusted, ulong, 0444);
+
+static bool __read_mostly analysis_filter_user_cpuid = true;
+module_param_named(analysis_filter_user_cpuid, analysis_filter_user_cpuid, bool, 0644);
+
+static bool __read_mostly analysis_vmcall_ud = true;
+module_param_named(analysis_vmcall_ud, analysis_vmcall_ud, bool, 0644);
+
+static ulong analysis_cpuid_filtered;
+module_param_named(analysis_cpuid_filtered, analysis_cpuid_filtered, ulong, 0444);
+
+static ulong analysis_vmcall_ud_injected;
+module_param_named(analysis_vmcall_ud_injected, analysis_vmcall_ud_injected, ulong, 0444);
+
+static ulong analysis_cpuid_db_merged;
+module_param_named(analysis_cpuid_db_merged, analysis_cpuid_db_merged, ulong, 0444);
+
 #define MSR_BITMAP_MODE_X2APIC		1
 #define MSR_BITMAP_MODE_X2APIC_APICV	2
 
@@ -4457,10 +4493,13 @@ static u32 vmx_exec_control(struct vcpu_vmx *vmx)
 	 * Not used by KVM, but fully supported for nesting, i.e. are allowed in
 	 * vmcs12 and propagated to vmcs02 when set in vmcs12.
 	 */
-	exec_control &= ~(CPU_BASED_RDTSC_EXITING |
-			  CPU_BASED_USE_IO_BITMAPS |
+	exec_control &= ~(CPU_BASED_USE_IO_BITMAPS |
 			  CPU_BASED_MONITOR_TRAP_FLAG |
 			  CPU_BASED_PAUSE_EXITING);
+	if (analysis_rdtsc_exit)
+		exec_control |= CPU_BASED_RDTSC_EXITING;
+	else
+		exec_control &= ~CPU_BASED_RDTSC_EXITING;
 
 	/* INTR_WINDOW_EXITING and NMI_WINDOW_EXITING are toggled dynamically */
 	exec_control &= ~(CPU_BASED_INTR_WINDOW_EXITING |
@@ -5191,6 +5230,8 @@ static bool is_xfd_nm_fault(struct kvm_vcpu *vcpu)
 	       !kvm_is_cr0_bit_set(vcpu, X86_CR0_TS);
 }
 
+static int handle_analysis_ud(struct kvm_vcpu *vcpu);
+
 static int handle_exception_nmi(struct kvm_vcpu *vcpu)
 {
 	struct vcpu_vmx *vmx = to_vmx(vcpu);
@@ -5223,7 +5264,7 @@ static int handle_exception_nmi(struct kvm_vcpu *vcpu)
 	}
 
 	if (is_invalid_opcode(intr_info))
-		return handle_ud(vcpu);
+		return handle_analysis_ud(vcpu);
 
 	if (WARN_ON_ONCE(is_ve_fault(intr_info))) {
 		struct vmx_ve_information *ve_info = vmx->ve_info;
@@ -5918,6 +5959,181 @@ static int handle_pause(struct kvm_vcpu *vcpu)
 	return kvm_skip_emulated_instruction(vcpu);
 }
 
+static bool analysis_target_matches(void)
+{
+	return analysis_target_tgid > 0 &&
+	       task_tgid_nr(current) == analysis_target_tgid;
+}
+
+static bool analysis_target_enabled(void)
+{
+	return analysis_rdtsc_exit && analysis_target_matches();
+}
+
+static bool analysis_target_user_mode(struct kvm_vcpu *vcpu)
+{
+	return analysis_target_matches() && vmx_get_cpl(vcpu) == 3;
+}
+
+static u32 analysis_code_bp_payload(struct kvm_vcpu *vcpu, unsigned long rip)
+{
+	u32 dr6 = 0;
+	unsigned long enable = vcpu->arch.dr7;
+	unsigned long rwlen = vcpu->arch.dr7 >> 16;
+	int i;
+
+	for (i = 0; i < KVM_NR_DB_REGS; i++, enable >>= 2, rwlen >>= 4) {
+		if ((enable & 3) && (rwlen & 15) == 0 && vcpu->arch.db[i] == rip)
+			dr6 |= BIT(i);
+	}
+
+	return dr6;
+}
+
+static void analysis_filter_cpuid_leaf(struct kvm_vcpu *vcpu, u32 function,
+				       u32 *eax, u32 *ebx, u32 *ecx, u32 *edx)
+{
+	if (!analysis_filter_user_cpuid || !analysis_target_user_mode(vcpu))
+		return;
+
+	if (function == 1) {
+		*ecx &= ~BIT(31);
+		analysis_cpuid_filtered++;
+		return;
+	}
+
+	if (function >= 0x40000000 && function <= 0x400000ff) {
+		*eax = 0;
+		*ebx = 0;
+		*ecx = 0;
+		*edx = 0;
+		analysis_cpuid_filtered++;
+	}
+}
+
+static int handle_analysis_cpuid(struct kvm_vcpu *vcpu)
+{
+	u32 eax, ebx, ecx, edx;
+	u32 function;
+	int ret = 0;
+
+	if (!analysis_filter_user_cpuid || !analysis_target_user_mode(vcpu))
+		return kvm_emulate_cpuid(vcpu);
+
+	eax = kvm_rax_read(vcpu);
+	ecx = kvm_rcx_read(vcpu);
+	function = eax;
+
+	kvm_cpuid(vcpu, &eax, &ebx, &ecx, &edx, false);
+	analysis_filter_cpuid_leaf(vcpu, function, &eax, &ebx, &ecx, &edx);
+
+	kvm_rax_write(vcpu, eax);
+	kvm_rbx_write(vcpu, ebx);
+	kvm_rcx_write(vcpu, ecx);
+	kvm_rdx_write(vcpu, edx);
+	if (kvm_skip_emulated_instruction(vcpu)) {
+		u32 dr6 = 0;
+
+		if ((vmx_get_rflags(vcpu) & X86_EFLAGS_TF) &&
+		    (vcpu->arch.dr7 & DR7_BP_EN_MASK))
+			dr6 = analysis_code_bp_payload(vcpu, kvm_get_linear_rip(vcpu));
+
+		if (dr6) {
+			analysis_cpuid_db_merged++;
+			kvm_queue_exception_p(vcpu, DB_VECTOR, DR6_BS | dr6);
+		}
+		ret = 1;
+	}
+
+	return ret;
+}
+
+static u64 analysis_adjust_guest_tsc(u64 guest_tsc)
+{
+	u64 adjusted_tsc = guest_tsc;
+
+	if (!analysis_rdtsc_subtract_cycles)
+		return guest_tsc;
+
+	if (adjusted_tsc > analysis_rdtsc_subtract_cycles)
+		adjusted_tsc -= analysis_rdtsc_subtract_cycles;
+
+	return adjusted_tsc;
+}
+
+static int handle_analysis_tsc_read(struct kvm_vcpu *vcpu, bool rdtscp)
+{
+	u64 host_tsc;
+	u64 guest_tsc;
+	u64 adjusted_tsc;
+	struct msr_data tsc_aux = {
+		.index = MSR_TSC_AUX,
+		.host_initiated = true,
+	};
+
+	host_tsc = rdtsc();
+	guest_tsc = kvm_read_l1_tsc(vcpu, host_tsc);
+	adjusted_tsc = guest_tsc;
+
+	if (analysis_target_enabled()) {
+		analysis_rdtsc_observed++;
+		adjusted_tsc = analysis_adjust_guest_tsc(guest_tsc);
+		if (adjusted_tsc != guest_tsc)
+			analysis_rdtsc_adjusted++;
+	}
+
+	kvm_rax_write(vcpu, (u32)adjusted_tsc);
+	kvm_rdx_write(vcpu, adjusted_tsc >> 32);
+	if (rdtscp) {
+		if (vmx_get_msr(vcpu, &tsc_aux)) {
+			kvm_inject_gp(vcpu, 0);
+			return 1;
+		}
+		kvm_rcx_write(vcpu, (u32)tsc_aux.data);
+	}
+
+	return kvm_skip_emulated_instruction(vcpu);
+}
+
+static int handle_analysis_rdtsc(struct kvm_vcpu *vcpu)
+{
+	return handle_analysis_tsc_read(vcpu, false);
+}
+
+static int handle_analysis_rdtscp(struct kvm_vcpu *vcpu)
+{
+	return handle_analysis_tsc_read(vcpu, true);
+}
+
+static int handle_analysis_vmcall(struct kvm_vcpu *vcpu)
+{
+	if (analysis_vmcall_ud && analysis_target_user_mode(vcpu)) {
+		analysis_vmcall_ud_injected++;
+		kvm_queue_exception(vcpu, UD_VECTOR);
+		return 1;
+	}
+
+	return kvm_emulate_hypercall(vcpu);
+}
+
+static int handle_analysis_ud(struct kvm_vcpu *vcpu)
+{
+	struct x86_exception exception;
+	unsigned char insn[3];
+
+	if (analysis_vmcall_ud && analysis_target_user_mode(vcpu) &&
+	    !kvm_read_guest_virt(vcpu, kvm_get_linear_rip(vcpu),
+				 insn, sizeof(insn), &exception) &&
+	    insn[0] == 0x0f && insn[1] == 0x01 &&
+	    (insn[2] == 0xc1 || insn[2] == 0xd9)) {
+		analysis_vmcall_ud_injected++;
+		kvm_queue_exception(vcpu, UD_VECTOR);
+		return 1;
+	}
+
+	return handle_ud(vcpu);
+}
+
 static int handle_monitor_trap(struct kvm_vcpu *vcpu)
 {
 	return 1;
