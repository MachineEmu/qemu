From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: unifi-qemu maintainers <qemu@localhost>
Date: Thu, 17 Sep 2026 14:10:00 +0200
Subject: [PATCH] hw/i386: use physical-client MADT overrides for analysis

QEMU's default identity-mapped interrupt-source overrides for IRQs 5, 9,
10, and 11 form a firmware fingerprint. Physical Intel client firmware
captured from the analysis profile's reference platform only publishes the
legacy IRQ 9 SCI override in addition to the standard IRQ 0 to GSI 2
override.

Keep the established QEMU layout for ordinary machines and select the
physical-client layout only for the opt-in analysis profile.
---
 hw/i386/acpi-build.c   | 3 ++-
 hw/i386/acpi-common.c  | 7 +++++--
 hw/i386/acpi-common.h  | 3 ++-
 hw/i386/acpi-microvm.c | 3 ++-
 4 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/hw/i386/acpi-common.h b/hw/i386/acpi-common.h
index 2dfde6d5af..a0dc9f015c 100644
--- a/hw/i386/acpi-common.h
+++ b/hw/i386/acpi-common.h
@@ -13,5 +13,6 @@ void pc_madt_cpu_entry(int uid, const CPUArchIdList *apic_ids,
 void acpi_build_madt(GArray *table_data, BIOSLinker *linker,
                      X86MachineState *x86ms,
-                     const char *oem_id, const char *oem_table_id);
+                     const char *oem_id, const char *oem_table_id,
+                     bool analysis_profile);
 
 #endif
diff --git a/hw/i386/acpi-common.c b/hw/i386/acpi-common.c
index 0d2f481de3..ae14492230 100644
--- a/hw/i386/acpi-common.c
+++ b/hw/i386/acpi-common.c
@@ -94,7 +94,8 @@ build_xrupt_override(GArray *entry, uint8_t src, uint32_t gsi, uint16_t flags)
  */
 void acpi_build_madt(GArray *table_data, BIOSLinker *linker,
                      X86MachineState *x86ms,
-                     const char *oem_id, const char *oem_table_id)
+                     const char *oem_id, const char *oem_table_id,
+                     bool analysis_profile)
 {
     int i;
     bool x2apic_mode = false;
@@ -129,8 +130,10 @@ void acpi_build_madt(GArray *table_data, BIOSLinker *linker,
             0 /* Flags: Conforms to the specifications of the bus */);
     }
 
+    const uint16_t pci_irq_mask = analysis_profile ? (1U << 9) :
+                                                    x86ms->pci_irq_mask;
     for (i = 1; i < 16; i++) {
-        if (!(x86ms->pci_irq_mask & (1 << i))) {
+        if (!(pci_irq_mask & (1 << i))) {
             /* No need for a INT source override structure. */
             continue;
         }
diff --git a/hw/i386/acpi-build.c b/hw/i386/acpi-build.c
index 8abf5f0e52..019138ee42 100644
--- a/hw/i386/acpi-build.c
+++ b/hw/i386/acpi-build.c
@@ -2094,7 +2094,8 @@ void acpi_build(AcpiBuildTables *tables, MachineState *machine)
 
     acpi_add_table(table_offsets, tables_blob);
     acpi_build_madt(tables_blob, tables->linker, x86ms,
-                    x86ms->oem_id, x86ms->oem_table_id);
+                    x86ms->oem_id, x86ms->oem_table_id,
+                    pcms->analysis_profile);
 
 #ifdef CONFIG_ACPI_ERST
     {
diff --git a/hw/i386/acpi-microvm.c b/hw/i386/acpi-microvm.c
index 89a9fb4854..0ff4c83804 100644
--- a/hw/i386/acpi-microvm.c
+++ b/hw/i386/acpi-microvm.c
@@ -203,7 +203,8 @@ static void acpi_build_microvm(AcpiBuildTables *tables,
 
     acpi_add_table(table_offsets, tables_blob);
     acpi_build_madt(tables_blob, tables->linker, X86_MACHINE(machine),
-                    x86ms->oem_id, x86ms->oem_table_id);
+                    x86ms->oem_id, x86ms->oem_table_id,
+                    false);
 
 #ifdef CONFIG_ACPI_ERST
     {
-- 
